{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/main",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agencies",
      "destination": "/agency",
      "permanent": true
    },
    {
      "source": "/brands",
      "destination": "/brand",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
